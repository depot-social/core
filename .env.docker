# Shared, local-only development defaults. No private credentials belong here.
NODE_ENV=development
DEPOT_ENV_FILE=../../.env.docker
PUBLIC_STRAPI_URL=http://127.0.0.1:1337
PUBLIC_DEPOT_BASE_URL=http://127.0.0.1:3000
PUBLIC_MAPBOX_TOKEN=""
PUBLIC_RANDOM_LOCATION_RADIUS=200
PUBLIC_CREATE_RESOURCE_STRAPI_API_TOKEN=""
NUXT_LAYERS=./base
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NUXT_PUBLIC_FEATURES_LOGIN=false
NUXT_PUBLIC_FEATURES_RESOURCE_EDITING=false
STRAPI_WAIT_TIMEOUT=600000
REDACT_PRECISE_RESOURCE_LOCATION=true
RESOURCE_AUTO_PUBLISH=false

HOST=0.0.0.0
PORT=1337
APP_KEYS=depot-dev-key-one,depot-dev-key-two,depot-dev-key-three,depot-dev-key-four
API_TOKEN_SALT=depot-dev-api-token-salt
ADMIN_JWT_SECRET=depot-dev-admin-jwt-secret
JWT_SECRET=depot-dev-user-jwt-secret

DATABASE_TYPE=mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=depot_berlin_strapi_ausleihe
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_DEBUG=false

STRAPI_PLUGIN_AVAILABILITIES=true
STRAPI_PLUGIN_CONVERSATIONS=true
STRAPI_PLUGIN_PRICES=true
STRAPI_PLUGIN_EMAILS=true
STRAPI_PLUGIN_RENTAL_AGREEMENT=true
STRAPI_PLUGIN_SEARCH=true

