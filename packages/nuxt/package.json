{
  "name": "@depot/nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter @depot/shared build && nuxt build --dotenv ../../.env",
    "dev": "nuxt dev --dotenv ../../.env",
    "generate": "nuxt generate --dotenv ../../.env",
    "preview": "nuxt preview --dotenv ../../.env",
    "postinstall": "nuxt prepare"
  },
