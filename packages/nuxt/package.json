    "@nuxtjs/leaflet": "1.3.2",
    "@nuxtjs/plausible": "2.0.1",
    "@nuxtjs/strapi": "2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@toast-ui/calendar": "^2.1.3",
    "classnames": "^2.5.1",
    "daisyui": "^5.5.20",
    "date-fns": "^3.6.0",
    "eslint": "^9.39.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "nuxt": "4.1.0",
    "qs": "^6.15.2",
    "tailwindcss": "^4.3.0",
