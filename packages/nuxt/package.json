{
  "name": "@depot/nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter @depot/shared build && nuxt build --dotenv ../../.env",
    "dev": "nuxt dev --dotenv ../../.env",
    "generate": "nuxt generate --dotenv ../../.env",
    "preview": "nuxt preview --dotenv ../../.env",
    "postinstall": "pnpm --filter @depot/shared build && nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/leaflet": "^1.3.3",
    "@nuxtjs/plausible": "^2.0.1",
    "@nuxtjs/strapi": "^2.2.0",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@toast-ui/calendar": "^2.1.3",
    "classnames": "^2.5.1",
    "daisyui": "^5.7.43",
    "date-fns": "^3.6.0",
    "eslint": "^9.39.5",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "nuxt": "^4.5.2",
    "qs": "^6.16.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@depot/shared": "workspace:^",
    "@nuxtjs/tailwindcss": "^6.14.0"
  },
  "author": "Felix Sänger <felix@depot.social>"
}
