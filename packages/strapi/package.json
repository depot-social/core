{
  "name": "@depot/strapi",
  "private": true,
  "version": "0.2.0",
  "description": "Strapi application providing data structures, admin UI, API, depot core policies and services",
  "scripts": {
    "dev": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" pnpm strapi develop",
    "develop": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" pnpm strapi develop",
    "start": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi start",
    "console": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi console",
    "build": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi build",
    "build:complete": "pnpm -r --filter @depot/shared --filter @depot/availabilities --filter @depot/conversations --filter @depot/emails --filter @depot/prices --filter @depot/rental-agreement --filter @depot/search --filter @depot/strapi build",
    "strapi": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi",
    "configuration:dump": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi configuration:dump -f configuration.json -p",
    "configuration:restore": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" strapi configuration:restore -f configuration.json",
    "setup:defaults": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" node ./cli/setup-defaults.cjs",
    "clear-cache": "rm -rf .cache && rm -rf dist",
    "generate-types": "pnpm strapi ts:generate-types",
    "cli:republish-resources": "ENV_PATH=\"${DEPOT_ENV_FILE:-./../../.env}\" node ./cli/republish-resources.js",
    "ci:install": "npx -y pnpm@10.15.0 install --frozen-lockfile",
    "ci:build": "npx -y pnpm@10.15.0 -r --filter @depot/shared --filter @depot/availabilities --filter @depot/conversations --filter @depot/emails --filter @depot/prices --filter @depot/rental-agreement --filter @depot/search --filter @depot/strapi build"
  },
  "dependencies": {
    "@depot/shared": "workspace:^",
    "@strapi-community/plugin-seo": "^2.1.1",
    "@strapi/plugin-documentation": "^5.60.0",
    "@strapi/plugin-users-permissions": "^5.60.0",
    "@strapi/provider-email-mailgun": "^5.60.0",
    "@strapi/provider-email-nodemailer": "^5.60.0",
    "@strapi/provider-email-sendmail": "^5.60.0",
    "@strapi/strapi": "^5.60.0",
    "@strapi/typescript-utils": "^5.60.0",
    "@strapi/utils": "^5.60.0",
    "@symlab/strapi-plugin-local-image-format": "^2.1.0",
    "axios": "^1.21.0",
    "better-sqlite3": "11.3.0",
    "date-fns": "^3.6.0",
    "lodash": "^4.18.1",
    "mime-types": "^2.1.35",
    "mysql2": "^3.24.6",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0"
  },
  "author": "Felix Sänger <felix@depot.social>",
  "strapi": {
    "uuid": ""
  },
  "license": "MIT",
  "main": "index.js",
  "devDependencies": {
    "@babel/runtime": "^7.29.10",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/koa": "^3.0.3",
    "codemirror": "^6.0.2"
  }
}
