{
  "name": "@depot/strapi",
  "private": true,
  "version": "0.2.0",
  "description": "Strapi application providing data structures, admin UI, API, depot core policies and services",
  "scripts": {
    "dev": "ENV_PATH=./../../.env pnpm strapi develop",
    "develop": "ENV_PATH=./../../.env pnpm strapi develop",
    "start": "ENV_PATH=./../../.env strapi start",
    "console": "ENV_PATH=./../../.env strapi console",
    "build": "ENV_PATH=./../../.env strapi build",
    "build:complete": "pnpm -r --filter @depot/shared --filter @depot/availabilities --filter @depot/conversations --filter @depot/emails --filter @depot/prices --filter @depot/rental-agreement --filter @depot/strapi build",
    "strapi": "ENV_PATH=./../../.env strapi",
    "configuration:dump": "ENV_PATH=./../../.env strapi configuration:dump -f configuration.json -p",
    "configuration:restore": "ENV_PATH=./../../.env strapi configuration:restore -f configuration.json",
    "clear-cache": "rm -rf .cache && rm -rf dist",
    "generate-types": "npm run strapi ts:generate-types --verbose",
    "cli:import-csv": "ENV_PATH=./../../.env node ./cli/import-csv.js",
    "cli:republish-resources": "ENV_PATH=./../../.env node ./cli/republish-resources.js",
    "ci:install": "npx -y pnpm@10.15.0 install --frozen-lockfile",
    "ci:build": "npx -y pnpm@10.15.0 -r --filter @depot/shared --filter @depot/availabilities --filter @depot/conversations --filter @depot/emails --filter @depot/prices --filter @depot/rental-agreement --filter @depot/strapi build"
  },
  "dependencies": {
    "@depot/shared": "workspace:^",
    "@strapi-community/plugin-seo": "^2.1.1",
    "@strapi/plugin-documentation": "^5.51.0",
    "@strapi/plugin-users-permissions": "^5.51.0",
    "@strapi/provider-email-mailgun": "^5.51.0",
    "@strapi/provider-email-nodemailer": "^5.51.0",
    "@strapi/provider-email-sendmail": "^5.51.0",
    "@strapi/strapi": "^5.51.0",
    "@strapi/typescript-utils": "^5.51.0",
    "@strapi/utils": "^5.51.0",
    "@symlab/strapi-plugin-local-image-format": "^2.1.0",
    "axios": "^1.18.1",
    "better-sqlite3": "11.3.0",
    "date-fns": "^3.6.0",
    "lodash": "^4.18.1",
    "mime-types": "^2.1.35",
    "mysql2": "^3.23.2",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.4"
  },
  "author": "Felix Sänger <felix@depot.social>",
  "strapi": {
    "uuid": ""
  },
  "license": "MIT",
  "main": "index.js",
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@types/koa": "^3.0.3",
    "codemirror": "^6.0.2"
  }
}
