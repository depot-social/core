{
  "name": "@depot/root",
  "version": "0.2.0",
  "description": "Resource booking platform and API",
  "scripts": {
    "start": "pnpm dev",
    "dev": "concurrently -k -n strapi,nuxt -c blue,green \"pnpm run dev:strapi\" \"pnpm run dev:nuxt\"",
    "dev:strapi": "pnpm --filter @depot/strapi run dev",
    "dev:nuxt": "wait-on -t ${STRAPI_WAIT_TIMEOUT:-120000} http-get://127.0.0.1:1337/_health && pnpm --filter @depot/nuxt run dev",
    "build:backend-packages": "pnpm --filter @depot/shared build && pnpm -r --filter @depot/availabilities --filter @depot/conversations --filter @depot/emails --filter @depot/prices --filter @depot/rental-agreement --filter @depot/search build",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:strapi": "pnpm build:backend-packages && pnpm --filter @depot/strapi setup:defaults",
    "build": "pnpm --filter @depot/* build",
    "test": "pnpm run test.unit",
    "prettier": "prettier --write .",
    "test.unit": "vitest"
  },
  "author": "Felix Sänger <felix@depot.social>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^0.34.7",
    "concurrently": "^10.0.5",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^0.34.6",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@depot/nuxt": "workspace:^",
    "@depot/shared": "workspace:^",
    "@depot/strapi": "workspace:^"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    }
  }
}
