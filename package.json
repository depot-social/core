{
  "name": "@depot/root",
  "version": "0.2.0",
  "description": "Resource booking platform and API",
  "scripts": {
    "start": "pnpm dev",
    "dev": "pnpm -r --parallel --filter @depot/strapi --filter @depot/nuxt run dev",
    "build": "pnpm --filter @depot/* build",
    "test": "pnpm run test.unit",
    "prettier": "prettier --write .",
    "test.unit": "vitest"
  },
  "author": "Felix Sänger <felix@depot.social>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^0.34.7",
    "prettier": "^2.8.8",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@depot/shared": "workspace:^",
    "@depot/strapi": "workspace:^",
    "@depot/nuxt": "workspace:^"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
