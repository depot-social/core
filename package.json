{
  "name": "@depot/root",
  "version": "0.2.0",
  "description": "Resource booking platform and API",
  "scripts": {
    "start": "pnpm dev",
    "dev": "concurrently -k -n strapi,nuxt -c blue,green \"pnpm run dev:strapi\" \"pnpm run dev:nuxt\"",
    "dev:strapi": "pnpm --filter @depot/strapi run dev",
    "dev:nuxt": "wait-on -t 120000 http-get://127.0.0.1:1337 && pnpm --filter @depot/nuxt run dev",
    "build": "pnpm --filter @depot/* build",
    "test": "pnpm run test.unit",
    "prettier": "prettier --write .",
    "test.unit": "vitest"
  },
  "author": "Felix Sänger <felix@depot.social>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^0.34.7",
    "concurrently": "^10.0.4",
    "prettier": "^2.8.8",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^0.34.6",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@depot/nuxt": "workspace:^",
    "@depot/shared": "workspace:^",
    "@depot/strapi": "workspace:^"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11",
      "onFail": "error"
    }
  }
}
